# Photobooth Admin Panel — environment template
# Copy to .env and fill with your Firebase web app config
# (Firebase Console → Project settings → General → Your apps → SDK setup).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave ALL of these empty to run in demo mode: every screen renders
# with seeded mock data and login accepts any credentials.
