# Firebase (copy this file to .env and replace values from Firebase Console > Project settings)
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# In-app purchases (see src/modules/monetization/.../services/iapAdapter.js).
# 'react-native-iap' (default) or 'revenuecat'.
EXPO_PUBLIC_IAP_VENDOR=react-native-iap
# Only needed when EXPO_PUBLIC_IAP_VENDOR=revenuecat (public SDK key).
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Android licence key from Play Console > Monetize > Products.
EXPO_PUBLIC_GOOGLE_LICENSE_KEY=

# AI filters.
# REMOVED ON PURPOSE: a Replicate API key must NEVER be shipped in the mobile
# bundle — anything in EXPO_PUBLIC_* is inlined into the JS and can be scraped
# out of the binary. The AI filter path runs server-side (Cloud Function holds
# the token). Leave this unset; the app uses the on-device filter presets.
# See docs/MOBILE-INTEGRATION-NOTES.md § AI filters.
# EXPO_PUBLIC_REPLICATE_API_KEY=