# ============================================================
# functions/.env.example
# Local emulator values only. In production these are Cloud Functions
# secrets, never .env files and never in the repo:
#   firebase functions:secrets:set REPLICATE_API_TOKEN --project photobooth-app-prod
# ============================================================

APP_ENV=development
FUNCTIONS_REGION=asia-southeast1
FIREBASE_PROJECT_ID=photobooth-app-dev

# Referenced via defineSecret() in code — resolved from Secret Manager at runtime
REPLICATE_API_TOKEN=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
INTERNAL_API_TOKEN=REPLACE_ME

# Non-secret operational config
FREE_PLAN_DAILY_CREDITS=5
MAX_UPLOAD_BYTES=10485760
AI_FILTER_TIMEOUT_MS=25000
RATE_LIMIT_PER_MINUTE=30