# ============================================================
# mobile/.env.example  ->  copy to mobile/.env.local (dev only)
# NEVER commit a real .env. Only EXPO_PUBLIC_* values live on the client.
# Anything that is a real secret (AI provider keys, payments) belongs in
# Cloud Functions secrets: firebase functions:secrets:set <NAME>
# ============================================================

# ---- environment selector ----
EXPO_PUBLIC_APP_ENV=development          # development | staging | production

# ---- Firebase (public client config — safe to ship) ----
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=photobooth-app-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=photobooth-app-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=photobooth-app-dev.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

# ---- EAS / OTA ----
EXPO_UPDATE_URL=https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID

# ---- Firebase App Check (public site/reCAPTCHA key only) ----
EXPO_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=REPLACE_ME

# ---- Feature flags (kill switches, no rebuild needed) ----
EXPO_PUBLIC_FLAG_AI_FILTERS=true
EXPO_PUBLIC_FLAG_AR_EFFECTS=true
EXPO_PUBLIC_FLAG_PREMIUM_PAYWALL=true

# ---- NOT here on purpose (server-side only) ----
# REPLICATE_API_TOKEN, STRIPE_SECRET_KEY, FCM server key, Google Play service account
# -> store in Cloud Functions secrets + GitHub Environment secrets