# ============================================================
# admin-panel/.env.example  (Vite + React)
# ------------------------------------------------------------
# v4 FIX: this template used to declare REACT_APP_* names while the panel source
# reads import.meta.env.VITE_* (src/services/firebase.js). With the old names the
# build produced isConfigured=false and every screen silently served mock data —
# in production too. The prefix below now matches the source and the panel's own
# admin-panel/.env.example one-for-one.
#
# WARNING: every VITE_* value is compiled INTO the public JS bundle, so it must be
# public-safe. Admin authorization is enforced by the custom claim + a live
# adminRoles/{uid} document in the root firestore.rules, never by anything here.
# ============================================================

VITE_APP_ENV=development
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=photobooth-app-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=photobooth-app-dev
VITE_FIREBASE_STORAGE_BUCKET=photobooth-app-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME

# Firebase App Check (web) — reCAPTCHA Enterprise site key (public by design)
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=REPLACE_ME

# Guard used by CI: fail the build if a production bundle still points at a
# staging project (release-production.yml scans build/assets/ for this value).
VITE_EXPECTED_PROJECT_ID=photobooth-app-prod