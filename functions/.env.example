# ============================================================================
# Photobooth Cloud Functions — environment variables
# ----------------------------------------------------------------------------
# Local dev:  copy to `functions/.env` and fill in the values you need.
# Production: set with `firebase functions:secrets:set <NAME>` (recommended) or
#             `firebase functions:config:set` for non-secret values, then
#             redeploy. NEVER commit a filled-in .env.
#
# The backend is designed to RUN WITHOUT most of these: store verification fails
# CLOSED (purchases land in `pending` for manual review) rather than granting
# premium on an unverifiable receipt.
# ============================================================================

# ---------------------------------------------------------------- project
GCLOUD_PROJECT=photobooth-app-prod
STORAGE_BUCKET=photobooth-app-prod.appspot.com

# ---------------------------------------------------------------- Apple App Store Server API
# Required for iOS premium verification. Without these, iOS purchases are stored as `pending`.
# Issuer ID + Key ID: App Store Connect → Users and Access → Integrations → In-App Purchase Keys
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Paste the .p8 contents with real newlines, or use literal \n escapes.
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.yourbrand.photobooth
# "sandbox" while testing with TestFlight / StoreKit sandbox accounts.
APPLE_ENVIRONMENT=production

# ---------------------------------------------------------------- Google Play
# Required for Android premium verification. Also used to validate RTDN package names.
GOOGLE_PLAY_PACKAGE_NAME=com.yourbrand.photobooth
# In Cloud Functions, Application Default Credentials are used automatically and the key path
# below is NOT needed. Only set it for local runs outside the emulator.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# ---------------------------------------------------------------- Stripe (web checkout)
# Used to verify the `Stripe-Signature` header on POST /storeWebhook?platform=stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------- AI filters (Replicate / SD)
# Read by the mobile app; kept here too so Cloud Functions can proxy if you move inference server-side.
REPLICATE_API_KEY=

# ---------------------------------------------------------------- emulator (local dev only)
# Set by `firebase emulators:start` automatically; listed for reference.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# STORAGE_EMULATOR_HOST=localhost:9199
